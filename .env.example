DATABASE_URL=postgres://adminfrc:<password>@localhost:5432/frcspieldaten
# 32+ zufällige Bytes, base64url. Erzeugen mit:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=<random-secret>
# "true", sobald die Instanz per HTTPS erreichbar ist (z.B. hinter
# nginx-proxy-manager mit SSL). Auf "false"/unset lassen, solange nur
# über http://<ip>:<port> ohne eigene Domain zugegriffen wird — sonst
# verwirft der Browser das Session-Cookie und der Login wirkt "erfolgreich",
# aber jede folgende Aktion meldet "Nicht angemeldet".
USE_SECURE_COOKIES=false
