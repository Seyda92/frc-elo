DATABASE_URL=postgres://adminfrc:<password>@localhost:5432/frcspieldaten
# 32+ zufällige Bytes, base64url. Erzeugen mit:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=<random-secret>
# "true", wenn die Instanz per HTTPS erreichbar ist (Produktion hinter
# nginx-proxy-manager). Nur für rein lokale Zugriffe über http:// auf
# "false" lassen — sonst verwirft der Browser das Session-Cookie und der
# Login wirkt "erfolgreich", aber jede folgende Aktion meldet
# "Nicht angemeldet".
USE_SECURE_COOKIES=true
